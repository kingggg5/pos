# Copy this file to .env before running Docker Compose.
# Replace both secrets with strong, unique values outside local development.
POSTGRES_DB=smart_pos
POSTGRES_USER=smartpos
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_PORT=5435

JWT_SIGNING_KEY=change-this-to-a-random-secret-with-at-least-32-characters

API_PORT=5002
WEB_PORT=8082
WEB_ORIGIN=http://localhost:8082
